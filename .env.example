# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000

# Required in production. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=replace-me-with-a-long-random-string

# ---------------------------------------------------------------------------
# Demo workspace
# ---------------------------------------------------------------------------
# Seed Elena's sample workspace when the local database is created.
# Set to false if you want an empty database.
SEED_DEMO=true

# Show the "Open demo" shortcut on the login screen.
DEMO_LOGIN_ENABLED=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local: leave empty to use embedded PGlite stored in ./.data/pglite
# Production/Supabase: set to your Postgres connection string.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Optional: Supabase Auth for Google / Apple sign-in
# ---------------------------------------------------------------------------
# Email/password auth does not require these values.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
